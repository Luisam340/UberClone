{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "App.js",
    "index.js"
  ],
  "exclude": [
    "node_modules",
    ".expo",
    "dist",
    "build",
    "ios",
    "android"
  ]
}