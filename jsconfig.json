{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["react-native"]
  },
  "exclude": [
    "node_modules",
    "android",
    "ios",
    ".expo"
  ]
}
